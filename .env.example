# Copy to .env and fill in values. Required keys match app/dep.py startup checks.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co

# Anon key — used by app.dep (SUPABASE_KEY) for user-scoped API calls
SUPABASE_KEY=your-anon-key

# Same anon key — used by some routes in main.py that read SUPABASE_ANON_KEY
SUPABASE_ANON_KEY=your-anon-key

# Service role — bypasses RLS; required for admin routes (app.dep SERVICE_KEY)
SERVICE_KEY=your-service-role-key

# Storage bucket for student face images (main.py uses raw_faces by default in code)
# SUPABASE_BUCKET=raw_faces

# Auth webhook (app/routes/auth_extra.py) — set in Supabase Auth hooks config
SUPABASE_WEBHOOK_SECRET=

# ── App URLs ─────────────────────────────────────────────────────────────────
APP_URL=https://faceattend.app
MVP_URL=https://mvp.faceattend.app/

# Comma-separated origins for CORS (optional; sensible defaults in main.py)
# CORS_ORIGINS=https://faceattend.app,https://www.faceattend.app

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Payments (Pesapal) ───────────────────────────────────────────────────────
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
PESAPAL_CALLBACK_URL=https://faceattend.app/dashboard
PESAPAL_IPN_URL=https://faceattend.app/api/cart/ipn

# ── AI summary (optional admin feature) ──────────────────────────────────────
OPENROUTER_API_KEY=
# AI_SUMMARY_MODEL=deepseek/deepseek-chat
# AI_AT_RISK_PCT=75
# AI_MIN_SESSIONS=3
# AI_SUMMARY_RECORD_LIMIT=1000

# ── Email / alerts ───────────────────────────────────────────────────────────
SUPER_ADMIN_EMAIL=admin@example.com
ZOHO_SMTP_USER=
ZOHO_ACCOUNT_ID=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# Notify router (contact form webhook)
NOTIFY_WEBHOOK_TOKEN=
ZOHO_USER=
ZOHO_PASSWORD=
# EMAIL_PROVIDER=smtp
# SMTP_TIMEOUT_SECONDS=20

# ── Deploy (DigitalOcean App Platform sets PORT automatically) ───────────────
# PORT=8080
